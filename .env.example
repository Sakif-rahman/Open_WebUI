# Documentation only. scripts/setup.ps1 creates the two ignored runtime env files.
# .env.open-webui:
WEBUI_SECRET_KEY=replace-with-a-random-secret
# .env.drawing (shared by Open WebUI and the drawing service):
DRAWING_API_KEY=replace-with-a-random-secret-at-least-32-characters
DRAWING_PUBLIC_URL=http://localhost:8001
DRAWING_MAX_IMAGES=1000
